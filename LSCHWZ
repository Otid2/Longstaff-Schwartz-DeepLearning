import numpy as np
import matplotlib.pyplot as plt

def lsmc_american_put(S0, K, r, T, sigma, M, N):
    dt = T / M

    discount = np.exp(-r * dt)
    
    # Simulation des trajectoires (Mouvement Brownien Géométrique)
    np.random.seed(42)
    z = np.random.standard_normal((M, N))
    simulated_paths = np.zeros((M + 1, N))
    simulated_paths[0] = S0



    for t in range(1, M + 1):
        simulated_paths[t] = simulated_paths[t - 1] * np.exp((r - 0.5 * sigma**2) * dt + sigma * np.sqrt(dt) * z[t - 1])
        
    # Gain à maturité pour chaque trajectoire 
    cashflows = np.maximum(K - simulated_paths[-1], 0) #payoff du put
    
    for t in range(M - 1, 0, -1):   #backprop
        itm = (simulated_paths[t] < K)
        if np.sum(itm) == 0:

            continue
            
        X = simulated_paths[t][itm]
        Y = cashflows[itm] * discount

      # Régression polynomiale (de degré 2)
        regression_coeffs = np.polyfit(X, Y, 2)
        continuation_value = np.polyval(regression_coeffs, X)
        
